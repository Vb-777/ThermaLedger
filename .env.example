# Copy to .env for local development: cp .env.example .env

# The role here must NOT be a superuser. Postgres silently ignores row-level
# security for superusers and BYPASSRLS roles, which would disable tenant
# isolation while every test still passed. docker/initdb/01-app-role.sql
# creates thermaledger_app for exactly this reason.
DATABASE_URL=postgres://thermaledger_app:thermaledger@localhost:5432/thermaledger

DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
LOG_LEVEL=INFO

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_ROOT=thermaledger
MQTT_USERNAME=
MQTT_PASSWORD=
